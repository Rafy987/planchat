# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres (with pgvector). Get it from the Neon dashboard -> Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Optional (defaults shown)
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=50
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# EMBEDDING_CACHE_DIR=.cache/fastembed

# LLM: "groq" (default, free) or "openai". The other one is used as fallback if it has a key.
LLM_PROVIDER=groq
GROQ_API_KEY=PASTE_HERE
OPENAI_API_KEY=PASTE_HERE
# Optional (defaults shown)
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENAI_MODEL=gpt-4o-mini
# TOP_K=5

# Browser sites allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:3000"]
# KEYWORD_TOP_K=3
# FLOORING_BATCH_TOKENS=1500
# FLOORING_MAX_OUTPUT_TOKENS=900
# FLOORING_MAX_WAIT_SECONDS=60

# Rate limits (defaults shown). On Render set TRUSTED_PROXY_HOPS=1.
# ASK_LIMIT_PER_MINUTE=10
# ASK_LIMIT_PER_DAY=100
# FLOORING_LIMIT_PER_HOUR=3
# UPLOAD_LIMIT_PER_HOUR=5
# DAILY_LLM_BUDGET=500
# MAX_PAGES=300
# FLOORING_MAX_CHUNKS=150
# TRUSTED_PROXY_HOPS=0

# Vision mode (Phase 11). Free tier ONLY for sample/public PDFs (Google may use free-tier data).
GEMINI_API_KEY=PASTE_HERE
